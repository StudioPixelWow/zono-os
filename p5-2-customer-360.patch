+            <li key={u.id} className="grid grid-cols-1 gap-1 px-2 py-2.5 sm:grid-cols-[1.6fr_1fr_0.8fr_0.9fr_0.9fr] sm:items-center sm:gap-3">
+              <span className="text-ink inline-flex items-center gap-2 text-[13.5px] font-bold">
