+.zlogin-head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: clamp(12px, 2.2vh, 20px); }
+.zlogin-title { margin-top: 14px; font-size: clamp(20px, 2.2vw, 27px); font-weight: 800; letter-spacing: -0.015em; line-height: 1.35; color: #1f2233; max-width: 20ch; }
+.zlogin-lede { margin-top: 8px; font-size: clamp(13px, 1vw, 14.5px); font-weight: 500; color: var(--z-muted); max-width: 34ch; line-height: 1.5; }
+.zlogin-card { width: 100%; max-width: 480px; padding: clamp(24px, 2.4vw, 34px) clamp(22px, 2.2vw, 32px); }
+
+/* ── LARGE ZI gateway character ────────────────────────────────────────────── */
+.zlogin-zi-stage { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 660px; }
+.zlogin-zi-img {
+  position: relative; z-index: 2;
+  height: clamp(400px, 62vh, 640px); width: auto;
+  filter: drop-shadow(0 36px 52px rgba(91, 33, 182, 0.22));
+  animation: zlogin-zi-float 8s ease-in-out infinite;
+}
+@keyframes zlogin-zi-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
+/* Wide, soft purple radial halo (never a hard circle). Pulses once on entry. */
+.zlogin-zi-glow {
+  position: absolute; z-index: 1; top: 50%; left: 50%;
+  width: clamp(460px, 46vw, 720px); height: clamp(460px, 46vw, 720px);
+  transform: translate(-50%, -46%);
+  background: radial-gradient(circle at 50% 46%, rgba(139, 92, 246, 0.22), rgba(124, 58, 237, 0.08) 46%, transparent 70%);
+  filter: blur(16px);
+  animation: zlogin-zi-pulse 2.6s ease-out 1;
+}
+@keyframes zlogin-zi-pulse { 0% { opacity: 0.55; } 60% { opacity: 1; } 100% { opacity: 0.9; } }
+/* Soft floor shadow — no physical surface. */
+.zlogin-zi-floor {
+  position: absolute; z-index: 1; bottom: clamp(4px, 2.4vh, 26px); left: 50%; transform: translateX(-50%);
+  width: clamp(200px, 18vw, 300px); height: 24px;
+  background: radial-gradient(ellipse at center, rgba(124, 58, 237, 0.22), transparent 70%);
+  filter: blur(10px);
+}
+/* One quiet label beside ZI — real text, not a chat bubble. Top-outer corner. */
+.zlogin-zi-label {
+  position: absolute; z-index: 5; top: clamp(2px, 3vh, 30px); inset-inline-start: clamp(-4px, 0vw, 16px);
+  padding: 7px 13px; border-radius: 999px;
+  background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(139, 92, 246, 0.24);
+  box-shadow: 0 10px 26px rgba(70, 40, 160, 0.10); backdrop-filter: blur(8px);
+  font-size: 12px; font-weight: 700; color: #5b3fb8; white-space: nowrap;
+}
+/* Exactly two capability chips, in OPPOSITE outer corners so they surround ZI
+   without covering it: one top toward the outer edge, one bottom toward the form. */
+.zlogin-chip { position: absolute; z-index: 4; width: clamp(188px, 13.5vw, 232px); }
+.zlogin-chip .zauth-chip-inner { white-space: normal; }
+.zlogin-chip.is-top { top: clamp(30px, 12vh, 120px); inset-inline-start: clamp(-24px, -1.5vw, 0px); }
+.zlogin-chip.is-bottom { bottom: clamp(24px, 10vh, 104px); inset-inline-end: clamp(-24px, -1.5vw, 0px); }
+
+/* Tablet + mobile: stack to one column — logo/headline/form, then a smaller ZI
+   below; hide the floating chips + label so the form is never crowded. */
+@media (max-width: 1024px) {
+  .zauth-shell { place-items: start center; padding-top: clamp(20px, 4vh, 40px); }
+  .zlogin-grid { grid-template-columns: 1fr; max-width: 520px; gap: 14px; }
+  .zlogin-form-col { grid-column: 1; order: 1; }
+  .zlogin-zi-col { grid-column: 1; grid-row: auto; order: 2; }
+  .zlogin-zi-img { height: clamp(170px, 28vh, 240px); }
+  .zlogin-zi-glow { width: 340px; height: 340px; }
+  .zlogin-chip, .zlogin-zi-label { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .zlogin-zi-img, .zlogin-zi-glow { animation: none !important; }
+}
 
 /* Header — elegant type; tightened spacing so the column feels balanced. */
 .zauth-head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 18px; }
