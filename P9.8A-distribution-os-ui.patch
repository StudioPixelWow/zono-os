+// ============================================================================
+// P9.8A — Distribution OS pure-logic tests: smart-alert rules + coverage math.
+// Run: npx tsx scripts/p9-8a-harness.mts
+// ============================================================================
+import { derivePropertyAlerts, buildDistributionAlerts, type PropertyAlertSignals } from "../src/lib/distribution/distribution-alerts-core.ts";
+
+let pass = 0, fail = 0;
+const ok = (n: string, c: boolean) => { if (c) pass++; else { fail++; console.log(`FAIL: ${n}`); } };
+
+const S = (o: Partial<PropertyAlertSignals>): PropertyAlertSignals => ({
+  propertyId: "p", title: "נכס", hasApprovedCreative: true, activeGroups: 5,
+  futureScheduledPosts: 3, daysSinceLastPublication: 1, coveragePct: 80, selectedGroups: 5, ...o,
+});
+
+ok("healthy property → no alerts", derivePropertyAlerts(S({})).length === 0);
+ok("no approved creative → action alert", derivePropertyAlerts(S({ hasApprovedCreative: false })).some((a) => a.key.endsWith("no_creative") && a.severity === "action"));
+ok("active groups + no plan + never published → no_plan", derivePropertyAlerts(S({ futureScheduledPosts: 0, daysSinceLastPublication: null })).some((a) => a.key.endsWith("no_plan")));
+ok("no_plan NOT raised when a future post exists", !derivePropertyAlerts(S({ futureScheduledPosts: 2, daysSinceLastPublication: null })).some((a) => a.key.endsWith("no_plan")));
+ok("stale (>7d) → warn", derivePropertyAlerts(S({ daysSinceLastPublication: 9 })).some((a) => a.key.endsWith("stale") && a.severity === "warn"));
+ok("fresh (<=7d) → no stale", !derivePropertyAlerts(S({ daysSinceLastPublication: 5 })).some((a) => a.key.endsWith("stale")));
+ok("low coverage (<50%) → warn", derivePropertyAlerts(S({ coveragePct: 30 })).some((a) => a.key.endsWith("low_coverage")));
+ok("full coverage → no low_coverage", !derivePropertyAlerts(S({ coveragePct: 100 })).some((a) => a.key.endsWith("low_coverage")));
+ok("no selected groups → no coverage alert", !derivePropertyAlerts(S({ selectedGroups: 0, coveragePct: 0 })).some((a) => a.key.endsWith("low_coverage")));
+ok("every alert has a CTA", derivePropertyAlerts(S({ hasApprovedCreative: false, daysSinceLastPublication: 9, coveragePct: 20 })).every((a) => a.cta.length > 0));
+
+// aggregation: action severity sorts before warn; cap respected
+const many: PropertyAlertSignals[] = Array.from({ length: 30 }, (_, i) => S({ propertyId: `p${i}`, hasApprovedCreative: false, daysSinceLastPublication: 9 }));
+const agg = buildDistributionAlerts(many, 20);
+ok("aggregation cap respected", agg.length === 20);
+ok("action alerts sort before warn", agg[0].severity === "action");
+
+console.log(`\n${pass}/${pass + fail} passed`);
+if (fail > 0) process.exit(1);
