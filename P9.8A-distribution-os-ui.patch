+// ============================================================================
+// ZONO — Distribution Smart Alerts (P9.8A §24) PURE core. No DB — unit-tested.
+// Deterministic, actionable rules over real per-property distribution signals.
+// Never noisy: one alert per genuine condition, each with a clear next action.
+// ============================================================================
+export interface PropertyAlertSignals {
+  propertyId: string;
+  title: string;
+  hasApprovedCreative: boolean;
+  activeGroups: number;
+  futureScheduledPosts: number;
+  daysSinceLastPublication: number | null;
+  coveragePct: number;        // 0..100 (confirmed/selected)
+  selectedGroups: number;
+}
+
+export type AlertSeverity = "action" | "warn" | "info";
+export interface DistributionAlert {
+  key: string; severity: AlertSeverity; propertyId: string; title: string;
+  message: string; cta: string;
+}
+
+const STALE_DAYS = 7;
+const LOW_COVERAGE_PCT = 50;
+
+/** Derive the alerts for ONE property. Order = most actionable first. Pure. */
+export function derivePropertyAlerts(s: PropertyAlertSignals): DistributionAlert[] {
+  const out: DistributionAlert[] = [];
+  const base = { propertyId: s.propertyId, title: s.title };
+  // No approved creative → cannot attach an image (blocks premium posts).
+  if (!s.hasApprovedCreative) {
+    out.push({ ...base, key: `${s.propertyId}:no_creative`, severity: "action", message: `“${s.title}” — אין קריאייטיב מאושר`, cta: "צור קריאייטיב" });
+  }
+  // Active groups but no plan → nothing will publish.
+  if (s.activeGroups > 0 && s.futureScheduledPosts === 0 && (s.daysSinceLastPublication == null || s.daysSinceLastPublication > STALE_DAYS)) {
+    out.push({ ...base, key: `${s.propertyId}:no_plan`, severity: "action", message: `“${s.title}” — אין תוכנית הפצה עתידית`, cta: "בנה תוכנית הפצה" });
+  }
+  // Stale — published once but long ago.
+  if (s.daysSinceLastPublication != null && s.daysSinceLastPublication > STALE_DAYS) {
+    out.push({ ...base, key: `${s.propertyId}:stale`, severity: "warn", message: `“${s.title}” — עברו ${s.daysSinceLastPublication} ימים מהפרסום האחרון`, cta: "פרסם שוב" });
+  }
+  // Low coverage — selected many groups, few confirmed.
+  if (s.selectedGroups > 0 && s.coveragePct < LOW_COVERAGE_PCT) {
+    out.push({ ...base, key: `${s.propertyId}:low_coverage`, severity: "warn", message: `“${s.title}” — כיסוי הפצה נמוך (${s.coveragePct}%)`, cta: "השלם פרסום לקבוצות" });
+  }
+  return out;
+}
+
+/** Aggregate alerts across properties, most actionable first, capped to avoid spam. */
+export function buildDistributionAlerts(properties: PropertyAlertSignals[], limit = 20): DistributionAlert[] {
+  const rank: Record<AlertSeverity, number> = { action: 0, warn: 1, info: 2 };
+  return properties.flatMap(derivePropertyAlerts).sort((a, b) => rank[a.severity] - rank[b.severity]).slice(0, limit);
+}
