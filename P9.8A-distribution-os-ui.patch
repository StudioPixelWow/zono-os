@@ -0,0 +1,86 @@
+"use client";
+// ============================================================================
+// ZONO — Property Distribution + Marketing Health card (P9.8A §4/§5/§6).
+// Premium, RTL. Real canonical data only (deterministic health + real coverage);
+// no fabricated reach/impressions. Loads via getPropertyDistributionAction.
+// ============================================================================
+import { useEffect, useState } from "react";
+import { Icon } from "@/components/dashboard/Icon";
+import { cn } from "@/lib/utils";
+import { getPropertyDistributionAction } from "@/lib/distribution/property-distribution-actions";
+import type { PropertyDistribution } from "@/lib/distribution/property-distribution-service";
+
+const healthTone = (n: number) => (n >= 75 ? "text-emerald-600" : n >= 45 ? "text-amber-600" : "text-red-600");
+const ring = (n: number) => (n >= 75 ? "#059669" : n >= 45 ? "#d97706" : "#dc2626");
+
+export function PropertyDistributionCard({ propertyId }: { propertyId: string }) {
+  const [data, setData] = useState<PropertyDistribution | null>(null);
+  const [state, setState] = useState<"loading" | "ready" | "error">("loading");
+
+  useEffect(() => {
+    let live = true;
+    getPropertyDistributionAction(propertyId)
+      .then((r) => { if (!live) return; if (r.ok) { setData(r.data); setState("ready"); } else setState("error"); })
+      .catch(() => live && setState("error"));
+    return () => { live = false; };
+  }, [propertyId]);
+
+  if (state === "loading") return <Shell><p className="text-muted text-sm">טוען נתוני הפצה…</p></Shell>;
+  if (state === "error" || !data) return <Shell><p className="text-muted text-sm">לא ניתן לטעון כרגע נתוני הפצה.</p></Shell>;
+
+  const h = data.health;
+  const cov = data.coverage;
+  return (
+    <Shell>
+      <div className="flex items-center justify-between gap-3">
+        <h3 className="text-ink flex items-center gap-2 font-black"><Icon name="Send" size={18} className="text-brand" /> מרכז הפצת הנכס</h3>
+        <span className="text-muted text-xs">{data.activeGroups} קבוצות פעילות ברשת</span>
+      </div>
+
+      <div className="mt-4 grid gap-4 sm:grid-cols-[auto_1fr]">
+        {/* Health ring */}
+        <div className="flex items-center gap-3">
+          <div className="relative grid h-20 w-20 place-items-center">
+            <svg viewBox="0 0 36 36" className="h-20 w-20 -rotate-90"><circle cx="18" cy="18" r="15.9" fill="none" stroke="var(--brand-border,#e5e5ea)" strokeWidth="3.4" /><circle cx="18" cy="18" r="15.9" fill="none" stroke={ring(h.score)} strokeWidth="3.4" strokeDasharray={`${h.score}, 100`} strokeLinecap="round" /></svg>
+            <div className="absolute text-center"><p className={cn("text-xl font-black leading-none", healthTone(h.score))}>{h.score}</p><p className="text-muted text-[10px]">בריאות</p></div>
+          </div>
+          <div className="text-xs">
+            {h.factors.map((f) => (
+              <p key={f.label} className={cn("flex items-center gap-1", f.ok ? "text-ink" : "text-muted")}>
+                <span className={f.ok ? "text-emerald-600" : "text-amber-600"}>{f.ok ? "✓" : "⚠"}</span> {f.label}
+              </p>
+            ))}
+          </div>
+        </div>
+
+        {/* Coverage + metrics */}
+        <div className="grid gap-3">
+          <div>
+            <div className="mb-1 flex items-center justify-between text-xs"><span className="text-muted font-bold">כיסוי הפצה</span><span className="text-ink font-black">{cov.confirmedGroups}/{cov.selectedGroups} · {cov.pct}%</span></div>
+            <div className="bg-surface h-2.5 w-full overflow-hidden rounded-full"><div className="bg-brand h-full rounded-full" style={{ width: `${cov.pct}%` }} /></div>
+            {cov.selectedGroups - cov.confirmedGroups > 0 && <p className="text-muted mt-1 text-[11px]">{cov.selectedGroups - cov.confirmedGroups} קבוצות עדיין ללא פרסום מאושר לנכס.</p>}
+          </div>
+          <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
+            <Metric label="פרסומים החודש" value={data.postsThisMonth} />
+            <Metric label="מתוזמנים" value={data.futureScheduledPosts} />
+            <Metric label="לידים מ-FB" value={data.facebookLeads} accent />
+            <Metric label="פרסום אחרון" text={data.daysSinceLastPublication == null ? "טרם" : `לפני ${data.daysSinceLastPublication}י׳`} />
+          </div>
+        </div>
+      </div>
+      <p className="text-muted mt-3 text-[11px]">״פורסם״ נספר רק כאשר הפרסום אושר ידנית בפועל. נתונים אמיתיים בלבד — ללא חשיפות/הקלקות מדומות.</p>
+    </Shell>
+  );
+}
+
+function Shell({ children }: { children: React.ReactNode }) {
+  return <section dir="rtl" className="border-line bg-card rounded-card border p-5 shadow-card">{children}</section>;
+}
+function Metric({ label, value, text, accent }: { label: string; value?: number; text?: string; accent?: boolean }) {
+  return (
+    <div className={cn("rounded-xl border p-2.5 text-center", accent ? "border-brand bg-brand-soft" : "border-line bg-surface")}>
+      <p className={cn("text-lg font-black", accent ? "text-brand-strong" : "text-ink")}>{text ?? value ?? 0}</p>
+      <p className="text-muted text-[10px] font-bold">{label}</p>
+    </div>
+  );
+}
