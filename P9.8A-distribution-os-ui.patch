+// ============================================================================
+// ZONO — Property Distribution metrics + Marketing Health (P9.8A, server-only).
+// ----------------------------------------------------------------------------
+// Computes a property's distribution facts from CANONICAL data only and feeds the
+// deterministic Marketing Health formula (P9.8). Every number distinguishes real
+// publish state (only publish_state='published' counts as published — §33) and is
+// org + property scoped (§34). No fabricated reach/impressions/clicks. Reuses the
+// existing schema — no migration.
+// ============================================================================
+import "server-only";
+import { createClient } from "@/lib/supabase/server";
+import { getSessionContext } from "@/lib/auth/session";
+import { computeMarketingHealth, type MarketingHealth } from "./property-marketing-health";
+import { buildDistributionAlerts, type DistributionAlert } from "./distribution-alerts-core";
+
+type Ctx = { orgId: string; userId: string | null };
+async function ctx(): Promise<Ctx | null> {
+  const { profile } = await getSessionContext();
+  if (!profile?.org_id) return null;
+  return { orgId: profile.org_id, userId: profile.id ?? null };
+}
+
+const daysBetween = (iso: string | null): number | null =>
+  iso ? Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000)) : null;
+
+export interface PropertyDistribution {
+  propertyId: string;
+  activeGroups: number;           // org groups in ACTIVE state
+  approvedCreatives: number;      // approved Creative Studio outputs for this property
+  postsThisMonth: number;         // CONFIRMED published posts this calendar month
+  futureScheduledPosts: number;   // scheduled ahead (a plan exists)
+  facebookLeads: number;          // leads attributed to facebook for this property
+  daysSinceLastPublication: number | null;
+  lastPublicationAt: string | null;
+  nextScheduledAt: string | null;
+  coverage: { selectedGroups: number; confirmedGroups: number; pct: number }; // §5 real coverage
+  health: MarketingHealth;        // §6 deterministic score + reasons
+}
+
+/**
+ * All distribution facts for one property, from canonical tables. "Published" means
+ * publish_state='published' ONLY — prepared/claimed/awaiting never count (§33).
+ */
+export async function getPropertyDistribution(propertyId: string): Promise<PropertyDistribution | null> {
+  const c = await ctx(); if (!c || !propertyId) return null;
+  const db = await createClient();
+  const nowIso = new Date().toISOString();
+  const monthStart = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString();
+
+  const [activeG, creatives, published, future, fbLeads, selectedGroups] = await Promise.all([
+    db.from("distribution_groups" as never).select("id", { count: "exact", head: true }).eq("org_id", c.orgId).eq("status", "active"),
+    db.from("zono_quick_creative_outputs" as never).select("id", { count: "exact", head: true }).eq("org_id", c.orgId).eq("property_id", propertyId).eq("is_approved", true),
+    db.from("distribution_posts" as never).select("group_id,published_at").eq("org_id", c.orgId).eq("property_id", propertyId).eq("publish_state", "published").order("published_at", { ascending: false }).limit(500),
+    db.from("distribution_posts" as never).select("scheduled_at").eq("org_id", c.orgId).eq("property_id", propertyId).gt("scheduled_at", nowIso).not("publish_state", "in", "(published,cancelled,dead_letter)").order("scheduled_at", { ascending: true }).limit(200),
+    db.from("leads" as never).select("id", { count: "exact", head: true }).eq("org_id", c.orgId).eq("property_id", propertyId).eq("source", "facebook"),
+    db.from("distribution_posts" as never).select("group_id").eq("org_id", c.orgId).eq("property_id", propertyId).not("group_id", "is", null).limit(1000),
+  ]);
+
+  const activeGroups = activeG.count ?? 0;
+  const approvedCreatives = creatives.count ?? 0;
+  const publishedRows = ((published.data ?? []) as unknown as Array<{ group_id: string | null; published_at: string | null }>);
+  const futureRows = ((future.data ?? []) as unknown as Array<{ scheduled_at: string | null }>);
+  const selectedRows = ((selectedGroups.data ?? []) as unknown as Array<{ group_id: string | null }>);
+
+  const postsThisMonth = publishedRows.filter((p) => p.published_at && p.published_at >= monthStart).length;
+  const lastPublicationAt = publishedRows[0]?.published_at ?? null;
+  const nextScheduledAt = futureRows[0]?.scheduled_at ?? null;
+
+  // Coverage = distinct groups selected for this property vs distinct groups where a
+  // publication was CONFIRMED. Only confirmed publish state counts (§5, §33).
+  const selectedSet = new Set(selectedRows.map((r) => r.group_id).filter(Boolean) as string[]);
+  const confirmedSet = new Set(publishedRows.map((r) => r.group_id).filter(Boolean) as string[]);
+  const selectedCount = selectedSet.size;
+  const confirmedCount = [...confirmedSet].filter((g) => selectedSet.has(g)).length;
+  const pct = selectedCount > 0 ? Math.round((confirmedCount / selectedCount) * 100) : 0;
+
+  const facebookLeads = fbLeads.count ?? 0;
+  const daysSinceLastPublication = daysBetween(lastPublicationAt);
+  const health = computeMarketingHealth({
+    hasApprovedCreative: approvedCreatives > 0,
+    activeGroups,
+    futureScheduledPosts: futureRows.length,
+    daysSinceLastPublication,
+    facebookLeads,
+  });
+
+  return {
+    propertyId,
+    activeGroups,
+    approvedCreatives,
+    postsThisMonth,
+    futureScheduledPosts: futureRows.length,
+    facebookLeads,
+    daysSinceLastPublication,
+    lastPublicationAt,
+    nextScheduledAt,
+    coverage: { selectedGroups: selectedCount, confirmedGroups: confirmedCount, pct },
+    health,
+  };
+}
+
+// ── Org-level smart alerts (P9.8A §24) — bounded to properties IN distribution ─
+/** Deterministic alerts across the org's properties that have distribution activity
+ *  (a distribution_post exists). Bounded so it never fans out over the whole catalog. */
+export async function getDistributionAlerts(): Promise<DistributionAlert[]> {
+  const c = await ctx(); if (!c) return [];
+  const db = await createClient();
+  const { data: postRows } = await db.from("distribution_posts" as never)
+    .select("property_id").eq("org_id", c.orgId).not("property_id", "is", null).limit(2000);
+  const ids = [...new Set(((postRows ?? []) as unknown as Array<{ property_id: string | null }>).map((r) => r.property_id).filter(Boolean) as string[])].slice(0, 40);
+  if (!ids.length) return [];
+  const { data: propRows } = await db.from("properties" as never).select("id,title").in("id", ids as never);
+  const titles = new Map(((propRows ?? []) as unknown as Array<{ id: string; title: string | null }>).map((p) => [p.id, p.title ?? "נכס"]));
+  const signals = [];
+  for (const id of ids) {
+    const d = await getPropertyDistribution(id);
+    if (!d) continue;
+    if (d.activeGroups === 0 && d.coverage.selectedGroups === 0 && d.futureScheduledPosts === 0) continue;
+    signals.push({
+      propertyId: id, title: titles.get(id) ?? "נכס",
+      hasApprovedCreative: d.approvedCreatives > 0, activeGroups: d.activeGroups,
+      futureScheduledPosts: d.futureScheduledPosts, daysSinceLastPublication: d.daysSinceLastPublication,
+      coveragePct: d.coverage.pct, selectedGroups: d.coverage.selectedGroups,
+    });
+  }
+  return buildDistributionAlerts(signals);
+}
